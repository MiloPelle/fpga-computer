// Clock: 27 MHz crystal
IO_LOC  "clk" 4;
IO_PORT "clk" IO_TYPE=LVCMOS33;

// Onboard LEDs (active-low)
IO_LOC  "led_out[0]" 15;
IO_PORT "led_out[0]" IO_TYPE=LVCMOS33;

IO_LOC  "led_out[1]" 16;
IO_PORT "led_out[1]" IO_TYPE=LVCMOS33;

IO_LOC  "led_out[2]" 17;
IO_PORT "led_out[2]" IO_TYPE=LVCMOS33;

IO_LOC  "led_out[3]" 18;
IO_PORT "led_out[3]" IO_TYPE=LVCMOS33;

IO_LOC  "led_out[4]" 19;
IO_PORT "led_out[4]" IO_TYPE=LVCMOS33;

IO_LOC  "led_out[5]" 20;
IO_PORT "led_out[5]" IO_TYPE=LVCMOS33;

//Onboard buttons (active-low, S1)
IO_LOC  "button1" 88; // PIN88_MODE0_KEY1
IO_PORT "button1" IO_TYPE=LVCMOS33;