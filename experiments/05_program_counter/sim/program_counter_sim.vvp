T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5e3f7a835240_0, 0, 1;
    %end;
    .thread T_1;
    .scope S_0x5e3f7a81eab0;
T_2 ;
    %delay 5000, 0;
    %load/vec4 v0x5e3f7a835240_0;
    %inv;
    %store/vec4 v0x5e3f7a835240_0, 0, 1;
    %jmp T_2;
